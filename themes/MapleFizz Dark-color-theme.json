{
	"name": "MapleFizz Dark",
	"$schema": "vscode://schemas/color-theme",
	"type": "dark",
	"colors": {
	  // —— Core surfaces (bring back the mauve charcoal #221C26) ——
	  "editor.background": "#121016",
	  "sideBar.background": "#121016",
	  "panel.background": "#121016",
	  "minimap.background": "#121016",
	  "breadcrumb.background": "#121016",
	  "dropdown.background": "#121016",
	  "editorWidget.background": "#121016",
	  "notifications.background": "#121016",
	  "titleBar.inactiveBackground": "#121016",
	  "titleBar.activeBackground": "#14121A",
	  "titleBar.border": "#6A103B40",
	  "sideBarSectionHeader.background": "#221C26",
	  "sideBarSectionHeader.border": "#DCF76340",
  
	  // —— Foregrounds ——
	  "editor.foreground": "#E5E5E8",
	  "sideBar.foreground": "#CFCFD2",
	  "menu.foreground": "#CFCFD2",
	  "breadcrumb.focusForeground": "#CFCFD2",
	  "editorLink.activeForeground": "#CFCFD2",
  
	  // —— Activity bar ——
	  "activityBar.background": "#121016",
	  "activityBar.foreground": "#CFCFD2",
	  "activityBar.border": "#6A103B33",
	  "activityBarBadge.background": "#FF8AD8",
	  "activityBarBadge.foreground": "#121016",
  
	  // —— Tabs (inactive uses the mauve charcoal) ——
	  "tab.border": "#121016",
	  "tab.activeBackground": "#941751",
	  "tab.activeForeground": "#FFF8FA",
	  "tab.activeBorder": "#FF2F92",
	  "tab.inactiveBackground": "#221C26",
	  "tab.inactiveForeground": "#CFCFD2B0",
	  "tab.unfocusedActiveBackground": "#6A103B80",
	  "tab.unfocusedActiveForeground": "#DADADA",
	  "tab.unfocusedInactiveBackground": "#221C26",
	  "tab.unfocusedInactiveForeground": "#CFCFD27A",
  
	  // —— Editor focus & selection (subtle plum line highlight) ——
	  "editor.lineHighlightBackground": "#22132640",
	  "editor.lineHighlightBorder": "#22132680",
	  "editor.selectionBackground": "#FF2F9270",
	  "editor.selectionHighlightBackground": "#9417514A",
	  "editor.selectionHighlightBorder": "#FF2F92",
	  "editor.wordHighlightBackground": "#94175133",
	  "editor.wordHighlightStrongBackground": "#FF8AD833",
	  "editorCursor.foreground": "#DCF763",
	  "editorWhitespace.foreground": "#FFFFFF20",
	  "editorRuler.foreground": "#21222F",
	  "editorBracketMatch.background": "#00000000",
	  "editorBracketMatch.border": "#DCF7637F",
  
	  // —— Find/Peek ——
	  "editor.findMatchBackground": "#121016",
	  "editor.findMatchBorder": "#FF8AD8",
	  "editor.findMatchHighlightBackground": "#FF8AD84D",
	  "editor.findMatchHighlightBorder": "#FF8AD899",
	  "peekView.border": "#6A103B33",
	  "peekViewEditor.matchHighlightBackground": "#94175155",
	  "peekViewResult.matchHighlightBackground": "#94175155",
  
	  // —— Hover/Suggest ——
	  "editorHoverWidget.background": "#17141D",
	  "editorHoverWidget.border": "#6A103B55",
	  "editorSuggestWidget.background": "#17141D",
	  "editorSuggestWidget.border": "#6A103B55",
	  "editorSuggestWidget.foreground": "#DADADA",
	  "editorSuggestWidget.highlightForeground": "#DCF763",
	  "editorSuggestWidget.selectedBackground": "#6A103B40",
  
	  // —— Gutter & diff (reduced palette, on-brand) ——
	  "editorGutter.addedBackground": "#DCF76377",
	  "editorGutter.modifiedBackground": "#FF2F927A",
	  "editorGutter.deletedBackground": "#6A103B99",
	  "diffEditor.insertedTextBackground": "#DCF76322",
	  "diffEditor.removedTextBackground": "#6A103B33",
  
	  // —— Diagnostics (on-brand triage) ——
	  "editorError.foreground": "#FF2F92CC",
	  "editorWarning.foreground": "#DCF763CC",
	  "editorInfo.foreground": "#941751CC",
	  "editorOverviewRuler.errorForeground": "#FF2F9240",
	  "editorOverviewRuler.warningForeground": "#DCF76370",
	  "editorOverviewRuler.infoForeground": "#94175155",
	  "editorMarkerNavigation.background": "#FFFFFF05",
  
	// —— Explorer & lists (refined + brighter hover) ——
	"list.hoverBackground": "#FF2F9266",             // vivid candy pink hover
	"list.hoverForeground": "#FFF8FA",               // clean contrast text
	"list.focusBackground": "#FF2F9280",             // stronger pink for keyboard focus
	"list.focusForeground": "#FFF8FA",
	"list.focusOutline": "#DCF76380",                // subtle yellow edge for focus clarity
	"list.activeSelectionBackground": "#FF2F92B0",   // deeper candy overlay for selected file
	"list.activeSelectionForeground": "#FFF8FA",
	"list.inactiveSelectionBackground": "#221C26",   // grounded mauve charcoal
	"list.inactiveSelectionForeground": "#FFF8FA",
	"list.highlightForeground": "#DCF763",           // search match highlight
	"list.warningForeground": "#DCF763",             // consistent yellow for warnings
	"list.filterMatchBackground": "#FF2F9244",       // stronger candy pink glow on matches
	"list.filterMatchBorder": "#FF2F92",             // sharp border for clarity
	"list.dropBackground": "#FF2F9244",              // transparent pink overlay for drag/drop
	"list.focusAndSelectionOutline": "#FF2F92C0",     // combined focus/selection accent
	"list.errorForeground": "#DCF763",

  
	  // —— Inputs / Menus ——
	  "input.background": "#1B1821",
	  "input.foreground": "#DADADA",
	  "input.placeholderForeground": "#DADADA66",
	  "input.border": "#FFFFFF12",
	  "inputOption.activeBackground": "#FFFFFF22",
	  "inputOption.activeBorder": "#FFFFFF22",
  
	  "menu.background": "#17141D",
	  "menu.border": "#6A103B66",
	  "menu.selectionBackground": "#221C26",
	  "menu.selectionBorder": "#00000000",
	  "menu.selectionForeground": "#DADADA",
	  "menu.separatorBackground": "#DADADA",
  
	  // —— Badges / Buttons ——
	  "badge.background": "#FF2F92",
	  "badge.foreground": "#FFF8FA",
	  "button.background": "#FF2F9260",
	  "button.hoverBackground": "#FF2F9280",
	  "extensionButton.prominentBackground": "#32174DCC",
	  "extensionButton.prominentHoverBackground": "#941751",
  
	  // —— Status bar ——
	  "statusBar.background": "#DCF763",
	  "statusBar.foreground": "#121016",
	  "statusBar.border": "#941751",
	  "statusBar.debuggingBackground": "#DCF763",
	  "statusBar.debuggingForeground": "#121016",
	  "statusBarItem.hoverBackground": "#6A103B33",
	  "statusBar.noFolderBackground": "#6A103B",
	  "statusBar.noFolderForeground": "#FFF8FA",
	  "statusBarItem.remoteBackground": "#FF2F92",
	  "statusBarItem.remoteForeground": "#FFF8FA",
  
	  // —— Panels & headers ——
	  "panel.border": "#6A103B7F",
	  "panelTitle.activeForeground": "#FFF8FA",
	  "panelTitle.inactiveForeground": "#CFCFD2",
	  "panelTitle.activeBorder": "#6A103B",
  
	  // —— Scrollbars / progress ——
	  "scrollbar.shadow": "#00000000",
	  "scrollbarSlider.background": "#6A103BBB",
	  "scrollbarSlider.hoverBackground": "#6A103BEE",
	  "scrollbarSlider.activeBackground": "#6A103BCC",
	  "progressBar.background": "#FF2F92",
  
	  // —— Breadcrumbs / groups ——
	  "breadcrumb.activeSelectionForeground": "#6A103B",
	  "breadcrumb.foreground": "#FF2F92",
	  "breadcrumbPicker.background": "#121016",
	  "editorGroup.border": "#FFFFFF1A",
	  "editorGroupHeader.tabsBackground": "#121016",
  
	  // —— Widgets / Peek ——
	  "editorWidget.border": "#DCF763",
	  "editorWidget.resizeBorder": "#6A103B",
	  "peekViewEditor.background": "#FFFFFF07",
	  "peekViewEditorGutter.background": "#FFFFFF07",
	  "peekViewResult.background": "#FFFFFF07",
	  "peekViewTitle.background": "#FFFFFF07",
	  "peekViewTitleDescription.foreground": "#FFFFFF99",
  
	  // —— Misc ——
	  "focusBorder": "#94175180",
	  "contrastBorder": "#6A103B40",
	  "notificationLink.foreground": "#6A103B",
	  "textLink.foreground": "#6A103B",
	  "textLink.activeForeground": "#DADADA",
	  "tree.indentGuidesStroke": "#32174D",
	  "widget.shadow": "#00000033",
  
	  // —— Git decorations (on-brand) ——
	  "gitDecoration.untrackedResourceForeground": "#FF8AD8",
	  "gitDecoration.modifiedResourceForeground": "#FF2F92",
	  "gitDecoration.deletedResourceForeground": "#6A103B",
	  "gitDecoration.ignoredResourceForeground": "#6A103B",
	  "gitDecoration.conflictingResourceForeground": "#DCF763",
  
	  // —— Explorer icon accents ——
	  "symbolIcon.folderForeground": "#FF2F92",
  
	  // —— Minimap ——
	  "minimapGutter.addedBackground": "#DCF763",
	  "minimapGutter.modifiedBackground": "#FF2F92",
	  "minimapGutter.deletedBackground": "#6A103B",
	  "minimapSlider.background": "#32174D80",
	  "minimapSlider.hoverBackground": "#32174DA0",
	  "minimapSlider.activeBackground": "#32174DB0",
  
	  // —— List filter widget ——
	  "listFilterWidget.background": "#FFFFFF1A",
	  "listFilterWidget.outline": "#00000000",
	  "listFilterWidget.noMatchesOutline": "#00000000",
  
	  // —— Line numbers ——
	  "editorLineNumber.foreground": "#941751",
	  "editorLineNumber.activeForeground": "#FF2F92",
  
	  // —— Terminal (directories use candy-pink via Blue slots) ——
	  "terminal.ansiBlack": "#121016",
	  "terminal.ansiRed": "#FF2F92",
	  "terminal.ansiGreen": "#DCF763",
	  "terminal.ansiYellow": "#DCF763",
	  "terminal.ansiBlue": "#FF2F92",
	  "terminal.ansiMagenta": "#FF8AD8",
	  "terminal.ansiCyan": "#32174D",
	  "terminal.ansiWhite": "#FFF8FA",
	  "terminal.ansiBrightBlack": "#6A103B",
	  "terminal.ansiBrightRed": "#FF2F92",
	  "terminal.ansiBrightGreen": "#DCF763",
	  "terminal.ansiBrightYellow": "#EEF88A",
	  "terminal.ansiBrightBlue": "#FF8AD8",
	  "terminal.ansiBrightMagenta": "#FFC1EC",
	  "terminal.ansiBrightCyan": "#6A103B",
	  "terminal.ansiBrightWhite": "#FFFFFF",
	  "terminalCursor.background": "#121016",
	  "terminalCursor.foreground": "#FF2F92"
	},
  
	"tokenColors": [
	  {
		"scope": [
		  "variable",
		  "string constant.other.placeholder",
		  "invalid.deprecated",
		  "keyword",
		  "storage.type",
		  "storage.modifier"
		],
		"settings": { "foreground": "#FF2F92" }
	  },
	  { "scope": ["variable", "entity.name.function"], "settings": { "fontStyle": "italic" } },
	  { "scope": ["punctuation.definition.interpolation.end.bracket.curly.scss","punctuation.definition.interpolation.begin.bracket.curly.scss"], "settings": { "foreground": "#32174D" } },
	  { "scope": ["constant.other.color"], "settings": { "foreground": "#FFF8FA" } },
	  { "scope": ["invalid","invalid.illegal"], "settings": { "foreground": "#6A103B" } },
	  { "scope": ["keyword.control","punctuation.definition.tag","punctuation","keyword.other.template","keyword.other.substitution"], "settings": { "foreground": "#A7A8AF" } },
	  { "scope": ["punctuation.definition.tag.begin.html","punctuation.definition.tag.end.html","entity.name.type.module.js"], "settings": { "foreground": "#941751" } },
	  { "scope": ["keyword.control.at-rule","keyword.operator.assignment.js","punctuation.separator.comma.js"], "settings": { "foreground": "#C0C0C0" } },
	  { "scope": ["keyword.control"], "settings": { "fontStyle": "bold" } },
	  { "scope": ["comment"], "settings": { "foreground": "#6D6F7C" } },
	  { "scope": ["entity.name.tag","meta.tag.sgml"], "settings": { "foreground": "#C0C0C0" } },
	  { "scope": ["entity.name.tag.html"], "settings": { "fontStyle": "bold" } },
	  { "scope": ["variable.parameter"], "settings": { "foreground": "#FF8AD8" } },
	  { "scope": ["variable.other.object.js","storage.type.js","variable.other.property.js"], "settings": { "foreground": "#941751" } },
	  { "scope": ["string","entity.name.function","markup.bold","markup.italic.markdown"], "settings": { "foreground": "#FF2F92" } },
	  { "scope": ["punctuation.definition.string.begin.html","punctuation.definition.string.end.html"], "settings": { "foreground": "#FF8AD8" } },
	  { "scope": ["support.other.variable","string.other.link","markup.table"], "settings": { "foreground": "#C0C0C0" } },
	  { "scope": ["constant.numeric","constant.language","constant.character","keyword.other.unit"], "settings": { "foreground": "#FF2F92" } },
	  { "scope": ["constant.other.symbol","markup.heading","meta.group.braces.curly"], "settings": { "foreground": "#32174D" } },
	  { "scope": ["entity.name","support.type","entity.other.attribute-name.html"], "settings": { "foreground": "#C0C0C0" } },
	  { "scope": ["source.css support.type.property-name","source.scss support.type.property-name"], "settings": { "foreground": "#941751" } },
	  { "scope": ["entity.name.method.js","tag.decorator.js entity.name.tag.js"], "settings": { "foreground": "#FF2F92","fontStyle": "italic" } },
	  { "scope": ["entity.other.attribute-name","support.function"], "settings": { "foreground": "#DCF763" } },
	  { "scope": ["entity.name.tag.css","keyword.control.conditional.js","meta.object-literal.key"], "settings": { "foreground": "#C0C0C0" } },
	  { "scope": ["markup.inserted"], "settings": { "foreground": "#32174D" } },
	  { "scope": ["markup.deleted"], "settings": { "foreground": "#6A103B" } },
	  { "scope": ["markup.changed"], "settings": { "foreground": "#DCF763" } },
	  { "scope": ["string.regexp","constant.character.escape"], "settings": { "foreground": "#FF8AD8" } },
	  { "scope": ["markdown.heading","entity.name.section.markdown"], "settings": { "foreground": "#DCF763","fontStyle": "bold" } },
	  { "scope": ["markup.underline"], "settings": { "foreground": "#FF2F92","fontStyle": "underline" } },
	  { "scope": ["markup.quote punctuation.definition.blockquote.markdown"], "settings": { "foreground": "#6A103B50" } },
	  { "scope": ["variable.language.fenced.markdown"], "settings": { "foreground": "#6A103B" } },
	  { "scope": "token.info-token", "settings": { "foreground": "#6A103B" } },
	  { "scope": "token.warn-token", "settings": { "foreground": "#DCF763" } },
	  { "scope": "token.error-token", "settings": { "foreground": "#FF293B" } },
	  { "scope": "token.debug-token", "settings": { "foreground": "#FF8AD8" } }
	]
  }
  