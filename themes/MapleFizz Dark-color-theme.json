{
	"name": "MapleFizz Dark",
	"$schema": "vscode://schemas/color-theme",
	"type": "dark",
	"colors": {
	  // --- Core surfaces (softer, less harsh) ---
	  "editor.background": "#121016",
	  "sideBar.background": "#121016",
	  "panel.background": "#121016",
	  "breadcrumb.background": "#121016",
	  "dropdown.background": "#121016",
	  "editorWidget.background": "#121016",
	  "notifications.background": "#121016",
	  "minimap.background": "#121016",
	  "titleBar.inactiveBackground": "#121016",
	  "titleBar.activeBackground": "#14121A",
	  "titleBar.border": "#6A103B40",
  
	  // --- Text & foregrounds ---
	  "editor.foreground": "#DADADA",
	  "sideBar.foreground": "#CFCFD2",
	  "menu.foreground": "#CFCFD2",
	  "breadcrumb.focusForeground": "#CFCFD2",
	  "editorLink.activeForeground": "#CFCFD2",
  
	  // --- Brand accents ---
	  "activityBar.background": "#121016",
	  "activityBar.foreground": "#CFCFD2",
	  "activityBar.border": "#6A103B33",
	  "activityBarBadge.background": "#FF2F92",
	  "activityBarBadge.foreground": "#121016",
  
	  // --- Tabs ---
	  "tab.border": "#121016",
	  "tab.activeBackground": "#6A103B",
	  "tab.activeForeground": "#FFF8FA",
	  "tab.activeBorder": "#FF8AD8",
	  "tab.inactiveBackground": "#221C26",
	  "tab.inactiveForeground": "#CFCFD2B0",
	  "tab.unfocusedActiveBackground": "#6A103B66",
	  "tab.unfocusedActiveForeground": "#DADADA",
	  "tab.unfocusedInactiveBackground": "#1A1620",
	  "tab.unfocusedInactiveForeground": "#CFCFD27A",
  
	  // --- Editor chrome & selections ---
	  "editor.lineHighlightBackground": "#FFFFFF08",
	  "editor.selectionBackground": "#FF2F9270",
	  "editor.selectionHighlightBackground": "#9417514A",
	  "editor.selectionHighlightBorder": "#FF2F92",
	  "editor.wordHighlightBackground": "#94175133",
	  "editor.wordHighlightStrongBackground": "#FF8AD833",
	  "editorCursor.foreground": "#DCF763",
	  "editorWhitespace.foreground": "#FFFFFF20",
	  "editorRuler.foreground": "#21222F",
	  "editorBracketMatch.background": "#00000000",
	  "editorBracketMatch.border": "#DCF7637F",
  
	  // --- Find/peek (more legible) ---
	  "editor.findMatchBackground": "#121016",
	  "editor.findMatchBorder": "#FF8AD8",
	  "editor.findMatchHighlightBackground": "#FF8AD84D",
	  "editor.findMatchHighlightBorder": "#FF8AD899",
	  "peekView.border": "#6A103B33",
	  "peekViewEditor.matchHighlightBackground": "#94175155",
	  "peekViewResult.matchHighlightBackground": "#94175155",
  
	  // --- Hover/suggest ---
	  "editorHoverWidget.background": "#17141D",
	  "editorHoverWidget.border": "#6A103B55",
	  "editorSuggestWidget.background": "#17141D",
	  "editorSuggestWidget.border": "#6A103B55",
	  "editorSuggestWidget.foreground": "#DADADA",
	  "editorSuggestWidget.highlightForeground": "#DCF763",
	  "editorSuggestWidget.selectedBackground": "#6A103B40",
  
	  // --- Gutter & diff ---
	  "editorGutter.addedBackground": "#32174D7A",
	  "editorGutter.modifiedBackground": "#FF2F927A",
	  "editorGutter.deletedBackground": "#64A6BD7A",
	  "diffEditor.insertedTextBackground": "#32174D22",
	  "diffEditor.removedTextBackground": "#64A6BD26",
  
	  // --- Markers & diagnostics (consistent mapping) ---
	  "editorError.foreground": "#FF2F92CC",
	  "editorWarning.foreground": "#DCF763CC",
	  "editorInfo.foreground": "#64A6BDCC",
	  "editorOverviewRuler.errorForeground": "#FF2F9240",
	  "editorOverviewRuler.warningForeground": "#DCF76370",
	  "editorOverviewRuler.infoForeground": "#64A6BD40",
	  "editorMarkerNavigation.background": "#FFFFFF05",
  
	  // --- Lists/trees (no jarring hot-pink hover) ---
	  "list.hoverBackground": "#221C26",
	  "list.hoverForeground": "#DADADA",
	  "list.focusBackground": "#1E1A23",
	  "list.focusForeground": "#FF2F92",
	  "list.activeSelectionBackground": "#1E1A23",
	  "list.activeSelectionForeground": "#FF2F92",
	  "list.inactiveSelectionBackground": "#6A103B66",
	  "list.inactiveSelectionForeground": "#FFF8FA",
	  "list.highlightForeground": "#6A103B",
	  "list.warningForeground": "#DCF763",
  
	  // --- Inputs ---
	  "input.background": "#1B1821",
	  "input.foreground": "#DADADA",
	  "input.placeholderForeground": "#DADADA66",
	  "input.border": "#FFFFFF12",
	  "inputOption.activeBackground": "#FFFFFF22",
	  "inputOption.activeBorder": "#FFFFFF22",
	  "inputValidation.infoBorder": "#64A6BD66",
	  "inputValidation.warningBorder": "#DCF76366",
	  "inputValidation.errorBorder": "#FF2F9266",
  
	  // --- Menus ---
	  "menu.background": "#17141D",
	  "menu.border": "#6A103B66",
	  "menu.selectionBackground": "#221C26",
	  "menu.selectionBorder": "#00000000",
	  "menu.selectionForeground": "#DADADA",
	  "menu.separatorBackground": "#DADADA",
  
	  // --- Badges/Buttons ---
	  "badge.background": "#FFFFFF1F",
	  "badge.foreground": "#6A103B",
	  "button.background": "#6A103B73",
	  "button.hoverBackground": "#6A103B99",
	  "extensionButton.prominentBackground": "#32174DCC",
	  "extensionButton.prominentHoverBackground": "#64A6BD",
  
	  // --- Status bar (kept brand splash but reduced glare) ---
	  "statusBar.background": "#DCF763",
	  "statusBar.foreground": "#121016",
	  "statusBar.border": "#00000000",
	  "statusBar.debuggingBackground": "#DCF763",
	  "statusBar.debuggingForeground": "#121016",
	  "statusBarItem.hoverBackground": "#6A103B33",
	  "statusBar.noFolderBackground": "#1B1821",
	  "statusBarItem.remoteBackground": "#FF2F92",
	  "statusBarItem.remoteForeground": "#FFF8FA",
  
	  // --- Panels & headers ---
	  "panel.border": "#6A103B7F",
	  "panelTitle.activeForeground": "#FFF8FA",
	  "panelTitle.inactiveForeground": "#CFCFD2",
	  "panelTitle.activeBorder": "#6A103B",
  
	  // --- Scrollbars & progress ---
	  "scrollbar.shadow": "#00000000",
	  "scrollbarSlider.background": "#6A103BBB",
	  "scrollbarSlider.hoverBackground": "#6A103BEE",
	  "scrollbarSlider.activeBackground": "#6A103BCC",
	  "progressBar.background": "#6A103B",
  
	  // --- Pickers / breadcrumbs / groups ---
	  "breadcrumb.activeSelectionForeground": "#6A103B",
	  "breadcrumb.foreground": "#941751",
	  "breadcrumbPicker.background": "#121016",
	  "editorGroup.border": "#FFFFFF1A",
	  "editorGroupHeader.tabsBackground": "#121016",
  
	  // --- PeekView/Widgets ---
	  "editorWidget.border": "#DCF763",
	  "editorWidget.resizeBorder": "#6A103B",
	  "peekViewEditor.background": "#FFFFFF07",
	  "peekViewEditorGutter.background": "#FFFFFF07",
	  "peekViewResult.background": "#FFFFFF07",
	  "peekViewTitle.background": "#FFFFFF07",
	  "peekViewTitleDescription.foreground": "#FFFFFF99",
  
	  // --- Misc ---
	  "focusBorder": "#94175180",
	  "contrastBorder": "#6A103B40",
	  "notificationLink.foreground": "#6A103B",
	  "textLink.foreground": "#6A103B",
	  "textLink.activeForeground": "#DADADA",
	  "tree.indentGuidesStroke": "#21222F",
	  "widget.shadow": "#00000033",
  
	  // --- Git decorations ---
	  "gitDecoration.untrackedResourceForeground": "#FF2F92",
	  "gitDecoration.modifiedResourceForeground": "#941751",
	  "gitDecoration.deletedResourceForeground": "#64A6BD",
	  "gitDecoration.ignoredResourceForeground": "#6A103B",
	  "gitDecoration.conflictingResourceForeground": "#DCF763",
  
	  // --- Minimap ---
	  "minimapGutter.addedBackground": "#64A6BD",
	  "minimapGutter.modifiedBackground": "#32174D",
	  "minimapGutter.deletedBackground": "#DCF763",
	  "minimapSlider.background": "#32174D80",
	  "minimapSlider.hoverBackground": "#32174DA0",
	  "minimapSlider.activeBackground": "#32174DB0",
  
	  // --- Lists filter widget ---
	  "listFilterWidget.background": "#FFFFFF1A",
	  "listFilterWidget.outline": "#00000000",
	  "listFilterWidget.noMatchesOutline": "#00000000",
  
	  // --- Terminal (clean, predictable ANSI mapping) ---
	  "terminal.ansiBlack":   "#121016",
	  "terminal.ansiRed":     "#FF2F92",
	  "terminal.ansiGreen":   "#DCF763",
	  "terminal.ansiYellow":  "#DCF763",
	  "terminal.ansiBlue":    "#941751",
	  "terminal.ansiMagenta": "#FF8AD8",
	  "terminal.ansiCyan":    "#64A6BD",
	  "terminal.ansiWhite":   "#FFF8FA",
	  "terminal.ansiBrightBlack":   "#6A103B",
	  "terminal.ansiBrightRed":     "#FF2F92",
	  "terminal.ansiBrightGreen":   "#DCF763",
	  "terminal.ansiBrightYellow":  "#EEF88A",
	  "terminal.ansiBrightBlue":    "#B04A7A",
	  "terminal.ansiBrightMagenta": "#FFC1EC",
	  "terminal.ansiBrightCyan":    "#8ED0E0",
	  "terminal.ansiBrightWhite":   "#FFFFFF",
	  "terminalCursor.background": "#121016",
	  "terminalCursor.foreground": "#FF2F92"
	},
  
	"tokenColors": [
	  // Keep your original tokenColors, with these tweaks for consistency:
	  {
		"scope": ["comment", "comment.block", "comment.line"],
		"settings": { "foreground": "#A7A8AF", "fontStyle": "italic" }
	  },
	  {
		"scope": ["keyword", "storage.type", "storage.modifier"],
		"settings": { "foreground": "#FF2F92", "fontStyle": "italic" }
	  },
	  {
		"scope": ["entity.name.function", "variable.function"],
		"settings": { "foreground": "#FF8AD8", "fontStyle": "" }
	  },
	  {
		"scope": ["string", "markup.inline.raw", "markup.fenced_code.block"],
		"settings": { "foreground": "#FF2F92" }
	  },
	  {
		"scope": ["constant.numeric", "constant.language", "constant.character"],
		"settings": { "foreground": "#DCF763" }
	  },
	  {
		"scope": ["entity.name.tag", "punctuation.definition.tag"],
		"settings": { "foreground": "#CFCFD2" }
	  },
	  {
		"scope": ["variable.parameter", "variable.parameter.function"],
		"settings": { "foreground": "#FF8AD8" }
	  },
	  {
		"scope": ["invalid", "invalid.illegal"],
		"settings": { "foreground": "#FF2F92" }
	  },
	  {
		"scope": ["meta.diff", "markup.inserted"],
		"settings": { "foreground": "#32174D" }
	  },
	  {
		"scope": ["markup.deleted"],
		"settings": { "foreground": "#64A6BD" }
	  }
	]
  }
  